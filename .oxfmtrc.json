{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "singleQuote": true,
  "semi": false,
  "printWidth": 100,
  "endOfLine": "lf",
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    ".yarn/**",
    ".claude/**",
    "docs/superpowers/**",
    "docs/api/**",
    "yarn.lock",
    "playwright-report/**",
    "test-results/**",
    ".harness/**"
  ]
}
